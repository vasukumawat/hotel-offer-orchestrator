PORT=3000
REDIS_URL=redis://localhost:6379
# temporal | local  (local = same orchestration logic without a Temporal server)
ORCHESTRATOR=temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers

# Supplier endpoints (default to the built-in mocks served by this app)
SUPPLIER_A_URL=http://localhost:3000/supplierA/hotels
SUPPLIER_B_URL=http://localhost:3000/supplierB/hotels
SUPPLIER_TIMEOUT_MS=2000

CACHE_TTL_SECONDS=300
DEGRADED_CACHE_TTL_SECONDS=30

# Mock failure simulation: ok | down | slow
SUPPLIER_A_MODE=ok
SUPPLIER_B_MODE=ok
